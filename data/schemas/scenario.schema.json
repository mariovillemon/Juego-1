{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "scenario.schema.json",
  "title": "Escenarios de avería (combinaciones de modos de fallo)",
  "type": "object",
  "required": ["scenarios"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "scenarios": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "car", "faults"],
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "common.schema.json#/$defs/id" },
          "name": { "type": "string" },
          "car": { "type": "string" },
          "difficulty": { "type": "integer", "minimum": 1, "maximum": 5 },
          "faults": { "type": "array", "minItems": 1, "items": { "$ref": "common.schema.json#/$defs/fault" } },
          "complaint": { "type": "string" }
        }
      }
    }
  }
}
