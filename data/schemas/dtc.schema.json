{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dtc.schema.json",
  "title": "Catálogo de códigos de avería OBD-II genéricos",
  "type": "object",
  "required": ["codes"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "codes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["code", "description", "descriptionEs", "system"],
        "additionalProperties": false,
        "properties": {
          "code": { "type": "string", "pattern": "^[PBCU][0-3][0-9A-F]{3}$" },
          "description": { "type": "string", "minLength": 5 },
          "descriptionEs": { "type": "string", "minLength": 5 },
          "system": { "type": "string" },
          "trips": { "type": "integer", "minimum": 1, "maximum": 2 },
          "mil": { "type": "boolean" },
          "causes": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
