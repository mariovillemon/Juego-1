{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "component_template.schema.json",
  "title": "Plantilla de componentes (conjunto reutilizable entre coches)",
  "type": "object",
  "required": ["id", "components"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "id": { "$ref": "common.schema.json#/$defs/id" },
    "description": { "type": "string" },
    "components": { "type": "array", "minItems": 1, "items": { "$ref": "component.schema.json" } }
  }
}
