{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "car.schema.json",
  "title": "Coche (combinación de motor, plantilla de componentes, calibración y apariencia)",
  "type": "object",
  "required": ["id", "brand", "model", "year", "engine", "template", "calibration"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "id": { "$ref": "common.schema.json#/$defs/id" },
    "brand": { "type": "string", "minLength": 2 },
    "model": { "type": "string", "minLength": 1 },
    "year": { "type": "integer", "minimum": 1950, "maximum": 2100 },
    "segment": { "type": "string" },
    "engine": { "type": "string" },
    "template": { "type": "string" },
    "calibration": { "type": "string" },
    "fuelRon": { "type": "number", "minimum": 80, "maximum": 110 },
    "massKg": { "type": "number", "minimum": 400, "maximum": 4000 },
    "wheelRadiusM": { "type": "number", "minimum": 0.2, "maximum": 0.5 },
    "gearRatios": { "type": "array", "items": { "type": "number", "exclusiveMinimum": 0 }, "minItems": 1, "maxItems": 10 },
    "finalDrive": { "type": "number", "exclusiveMinimum": 0 },
    "drivetrainEfficiency": { "type": "number", "minimum": 0.5, "maximum": 1 },
    "dragAreaM2": { "type": "number", "exclusiveMinimum": 0 },
    "experimental": { "type": "boolean" },
    "vin": { "type": "string", "pattern": "^[A-HJ-NPR-Z0-9]{17}$" },
    "modules": { "type": "array", "items": { "enum": ["ecm", "abs", "ipc", "bcm", "tcm"] }, "uniqueItems": true },
    "appearance": { "$ref": "appearance.schema.json" },
    "removeComponents": { "type": "array", "items": { "type": "string" } },
    "addComponents": { "type": "array", "items": { "$ref": "component.schema.json" } },
    "componentOverrides": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "params": { "type": "object", "additionalProperties": { "type": "number" } }
        }
      }
    }
  }
}
