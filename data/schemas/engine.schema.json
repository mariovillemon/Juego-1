{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "engine.schema.json",
  "title": "Motor (definición física)",
  "type": "object",
  "required": ["id", "name", "kind", "cylinders", "displacementL", "compressionRatio", "ve", "mbt"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "id": { "$ref": "common.schema.json#/$defs/id" },
    "name": { "type": "string" },
    "kind": { "enum": ["GasolineNA", "GasolineTurbo", "DieselTurbo", "Hybrid", "Electric"] },
    "cylinders": { "type": "integer", "minimum": 1, "maximum": 12 },
    "displacementL": { "type": "number", "exclusiveMinimum": 0, "maximum": 10 },
    "boreMm": { "type": "number", "minimum": 40, "maximum": 150 },
    "strokeMm": { "type": "number", "minimum": 40, "maximum": 150 },
    "compressionRatio": { "type": "number", "minimum": 6, "maximum": 25 },
    "firingOrder": { "type": "array", "items": { "type": "integer", "minimum": 1 } },
    "redlineRpm": { "type": "number", "minimum": 2000, "maximum": 12000 },
    "mechanicalLimitRpm": { "type": "number", "minimum": 2000, "maximum": 13000 },
    "throttleDiameterMm": { "type": "number", "minimum": 20, "maximum": 120 },
    "inertiaKgM2": { "type": "number", "exclusiveMinimum": 0 },
    "knockMarginDeg": { "type": "number" },
    "fuelRon": { "type": "number", "minimum": 80, "maximum": 110 },
    "injectorFlowCcMin": { "type": "number", "exclusiveMinimum": 0 },
    "injectorRefPressureKpa": { "type": "number", "exclusiveMinimum": 0 },
    "railPressureKpa": { "type": "number", "exclusiveMinimum": 0 },
    "pumpMaxPressureKpa": { "type": "number", "exclusiveMinimum": 0 },
    "thermalCapacityKjK": { "type": "number", "exclusiveMinimum": 0 },
    "thermostatOpenC": { "type": "number", "minimum": 60, "maximum": 115 },
    "radiatorKwK": { "type": "number", "exclusiveMinimum": 0 },
    "frictionFactor": { "type": "number", "exclusiveMinimum": 0 },
    "indicatedEfficiency": { "type": "number", "minimum": 0.2, "maximum": 0.5 },
    "ve": { "$ref": "common.schema.json#/$defs/table" },
    "mbt": { "$ref": "common.schema.json#/$defs/table" },
    "turbo": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxBoostKpa": { "type": "number", "minimum": 0, "maximum": 400 },
        "fullSpoolRpm": { "type": "number" },
        "spoolStartRpm": { "type": "number" },
        "wastegateSpringKpa": { "type": "number", "minimum": 0 },
        "maxSafeBoostKpa": { "type": "number", "minimum": 0 },
        "compressorEfficiency": { "type": "number", "minimum": 0.4, "maximum": 0.85 },
        "intercoolerEffectiveness": { "type": "number", "minimum": 0, "maximum": 1 },
        "spoolTimeConstant": { "type": "number", "exclusiveMinimum": 0 },
        "maxFlowGps": { "type": "number", "exclusiveMinimum": 0 }
      }
    }
  }
}
