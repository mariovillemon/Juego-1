{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "failure_mode.schema.json",
  "title": "Modos de fallo genéricos",
  "type": "object",
  "required": ["modes"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "modes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "effect", "appliesTo"],
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "common.schema.json#/$defs/id" },
          "name": { "type": "string" },
          "family": { "enum": ["signal", "wiring", "leak", "mechanical", "actuator", "electrical", "network"] },
          "effect": { "enum": ["SignalOffset", "SignalGain", "SignalStuck", "SignalNoise", "SignalLag", "SignalDropout", "WireOpen",
            "WireShortGround", "WireShortPower", "WireHighResistance", "ConnectorCorrosion", "Leak", "Restriction", "Wear", "StuckOpen",
            "StuckClosed", "Clog", "Weak", "Dead", "Slack", "InternalShort", "Dribble"] },
          "appliesTo": { "type": "array", "minItems": 1, "items": { "$ref": "common.schema.json#/$defs/componentKind" } },
          "pin": { "type": "string" },
          "magnitudeMin": { "type": "number" },
          "magnitudeMax": { "type": "number" },
          "difficulty": { "type": "integer", "minimum": 1, "maximum": 5 },
          "repair": { "enum": ["replace", "repair_wire", "clean", "adjust"] },
          "description": { "type": "string" },
          "conditions": { "type": "array", "items": { "enum": ["Always", "Cold", "Hot", "AboveLoad", "AboveRpm", "BelowRpm", "Vibration", "Intermittent"] } }
        }
      }
    }
  }
}
